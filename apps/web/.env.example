# Server-side only. Never prefix with NEXT_PUBLIC_: these values must not reach the browser.
# Set them in the Vercel project (Settings → Environment Variables), not in the repo.

# RPC Fast Solana mainnet endpoint, exactly as shown in the RPC Fast dashboard.
# Used only by POST /api/solana-rpc (same-origin proxy for /shield and balance reads).
RPC_FAST_URL=
# Only when the key is sent as a header instead of in the URL:
# RPC_FAST_API_KEY=
# RPC_FAST_API_KEY_HEADER=x-api-key

# Extra browser origins allowed to call the proxy (comma separated), besides the site's own.
# RPC_PROXY_ALLOWED_ORIGINS=
