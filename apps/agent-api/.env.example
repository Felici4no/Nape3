# Copy to apps/agent-api/.env (gitignored). Server-side only: never in the extension or NEXT_PUBLIC_*.

# RPC Fast Solana mainnet endpoint, exactly as shown in the RPC Fast dashboard.
# If the dashboard URL already contains the key, leave RPC_FAST_API_KEY empty.
RPC_FAST_URL=
# Only when the key is sent as a header instead of in the URL:
RPC_FAST_API_KEY=
# Header name for the key (default x-api-key); check the dashboard.
RPC_FAST_API_KEY_HEADER=

# OBSERVER_API_URL=http://127.0.0.1:8787
# OBSERVER_READ_TOKEN=
# AGENT_STORE=pglite
